# Where the Vayora API runs and the key the dashboard uses (server-side only, never sent to the browser)
VAYORA_API_URL=http://localhost:8080
VAYORA_API_KEY=sk_test_change_me
# Dashboard sign-in. Both are required; use a long random value for the secret (openssl rand -hex 32).
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=change-me-too
