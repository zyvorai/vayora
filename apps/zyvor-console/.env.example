# Where the Zyvor API runs and the key the console uses (server-side only, never sent to the browser).
# Use a key with the scopes the console needs: payments:read, refunds:write, refunds:approve, recon:read,
# recon:write, collections:write, billing:write, invoices:write.
ZYVOR_API_URL=http://localhost:8080
ZYVOR_API_KEY=zk_test_change_me
# Name recorded in the audit trail for actions taken here (the API enforces that a refund's requester cannot approve it).
CONSOLE_USER=ops
# Console sign-in. Both are required; use a long random value for the secret (openssl rand -hex 32).
CONSOLE_PASSWORD=change-me
CONSOLE_SESSION_SECRET=change-me-too
CHECKOUT_PUBLIC_URL=http://localhost:3002
# Named users with roles and TOTP live in the API (People page). The deployment admin above can sign in only
# until the first named user exists. Set to 1 to force everyone to set up a second factor before using the app.
CONSOLE_REQUIRE_MFA=0
# Show the "Draft with AI" button (the API must have ZYVOR_AI_API_KEY set; drafts are always reviewed by a person)
CONSOLE_AI=0
