FROM node:22-slim AS build
WORKDIR /src
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @zyvor/node build \
 && ZYVOR_API_KEY=build CONSOLE_PASSWORD=build CONSOLE_SESSION_SECRET=build pnpm --filter @zyvor/console build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3003
COPY --from=build /src /app
USER node
EXPOSE 3003
WORKDIR /app/apps/zyvor-console
CMD ["node_modules/.bin/next", "start", "-p", "3003"]
